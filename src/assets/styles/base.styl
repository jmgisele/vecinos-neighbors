@require 'colors'

*
  box-sizing: border-box

  &::selection
    color: $bg
    background-color: $accent

html
  margin: 0
  padding: 0
  font-size: 16px

  body
    min-height: 100vh
    margin: 0
    font-family: 'Inter', sans-serif
    font-feature-settings: 'zero' on, 'ss01' on, 'cv05' on
    font-size: 1rem

    h1, h2, h3
      font-feature-settings: 'cv11' on, 'cv05' off, 'cv08' on
