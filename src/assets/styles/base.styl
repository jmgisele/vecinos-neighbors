@require 'colors'
@require 'corners'

*
  box-sizing: border-box
  -webkit-tap-highlight-color: transparent

  &::selection
    color: $bg
    background-color: $accent

  &:focus
    outline: none !important // Important is needed to hide focus outlines in Firefox

html
  margin: 0
  padding: 0
  font-size: 16px

  body
    min-height: 100vh
    margin: 0
    font-family: 'Inter', sans-serif
    font-feature-settings: 'zero' on, 'ss01' on, 'cv05' on
    font-size: 1rem
    line-height: 1.5
    hyphens: auto
    overflow-wrap: break-word
    word-wrap: break-word
    color: $text
    background-color: $bg

    &.dark
      color: $text-dark
      background-color: $bg-dark

      *::selection
        background-color: $accent-secondary

      blockquote footer
        color: $text-secondary-dark

      pre
        background-color: $bg-secondary-dark

        code
          background-color: initial

      table
        thead tr th
          border-bottom: 2px solid $bg-secondary-dark

        tbody tr
          &:nth-child(even)
            background-color: $bg-secondary-dark

            code
              background-color: $bg-tertiary-dark

      hr
        background-color: $bg-secondary-dark

      code, kbd
        background-color: $bg-secondary-dark

      kbd
        color: $text-dark
        border-color: $bg-tertiary-dark
        box-shadow: 0 1px 0 $bg-tertiary-dark, inset 0 0 0 1px $bg-secondary-dark
        text-shadow: none

    h1, h2, h3
      font-feature-settings: 'cv11' on, 'cv05' off, 'cv08' on

    h1
      margin-top: 4rem
      margin-bottom: 2rem
      font-size: 2rem

      + h2
        margin-top: 2rem

    h2
      margin-top: 3rem
      margin-bottom: 1.5rem
      font-size: 1.5rem

      + h3
        margin-top: 1.5rem

    h3
      margin-top: 2rem
      margin-bottom: 1rem
      font-size: 1.25rem

    h4, h5, h6
      margin-top: 1.5rem
      margin-bottom: 1rem
      font-size: 1rem

    p
      margin: 1rem 0

    ol,
    ul
      margin-top: 1rem
      margin-bottom: 1rem
      margin-left: 1.5rem
      padding-left: 0

      ol
        list-style-type: lower-alpha

        ol
          list-style-type: lower-roman

    blockquote
      margin-top: 1rem
      margin-bottom: 1rem
      margin-left: 0.5rem
      padding-left: 1rem
      position: relative

      &::before
        content: ''
        display: block
        background-color: $accent-secondary
        position: absolute
        width: 2px
        height: 100%
        left: 0

      > footer
        font-style: italic
        color: $text-secondary

        &::before
          content: '– '

    pre
      margin: 2rem 0
      padding: 1rem
      background-color: $bg-tertiary-dark
      color: $bg
      border-radius: $radius-l
      overflow: auto
      white-space: pre-wrap

      code
        display: inline
        padding: 0
        background-color: initial
        white-space: pre-wrap

    .table-wrapper
      overflow-x: auto
      margin-bottom: 2rem

    table
      width: 100%
      border-collapse: collapse

      th, td
        padding: 1rem
        vertical-align: baseline

      thead tr th
        white-space: nowrap
        text-align: left
        border-bottom: 2px solid $bg-secondary

      tbody tr
        &:nth-child(even)
          background-color: $bg-tertiary

    hr
      border: none
      background-color: $bg-secondary
      height: 0.125rem
      margin-top: 4rem
      margin-bottom: 4rem

    a
      color: $accent
      text-decoration: none
      background-image: linear-gradient($accent-secondary, $accent-secondary)
      background-position: 100% 100%
      background-repeat: no-repeat
      background-size: 0% 2px
      transition: background-size 200ms ease

      &:hover,
      &:focus
        background-position: 0% 100%
        background-size: 100% 2px

    code
      display: inline-block
      font-family: monospace
      background-color: $bg-secondary
      padding: 0.25rem 0.5rem
      border-radius: $radius-m
      hyphens: manual

    kbd
      font-family: 'Inter', sans-serif
      letter-spacing: 1px
      text-align: center
      display: inline-block
      min-width: 1.5rem
      margin: 0 0.1rem
      padding: 0rem 0.25rem
      border-radius: $radius-s
      border: 1px solid $text-tertiary
      box-shadow: 0 1px 0 $text-tertiary, inset 0 0 0 1px $bg
      color: $text
      background-color: $bg-secondary
      text-shadow: 0 1px 0 $bg
      font-size: 0.875rem
