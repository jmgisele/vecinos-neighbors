---
import Section from '../ui/Section.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { cn } from '../../lib/cn';
import type { SplitBlock } from '../../lib/data';
import RichText from './RichText.astro';
import Gallery from './Gallery.astro';

interface Props { data: SplitBlock }

const { data } = Astro.props;
const actions = (data.actions ?? []).filter(a => a !== null);
console.log(data);
---
<Section>
		<div class="mx-auto grid max-w-6xl items-center gap-10 md:grid-cols-2 md:gap-16">
				<div class={cn('space-y-6', data.reverse && 'md:order-2')}>
						{data?.title && <h2  class="text-balance text-3xl font-semibold lg:text-4xl">{data?.title}</h2>}
						{data?.content && (
						<div  class="prose prose-lg max-w-none text-muted-foreground">
								<RichText body={data.content.body}></RichText>
						</div>
						)}
				</div>
				{data.images?.length > 0 && (
				<div  class="bg-background overflow-hidden rounded-2xl">
						<Gallery data={data} />
				</div>
				)}
		</div>
</Section>
