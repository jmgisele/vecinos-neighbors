---
import {
	Swiper,
	SwiperWrapper,
	SwiperSlide,
	SwiperPagination,
} from "astro-swiper";
interface Props {
	data: any;
	height?: string;
	width?: string;
}

const { data, height = "500px", width = "100%" } = Astro.props;

const images = data.images ?? [];
---

<section class="w-full min-h-400px">
  <Swiper
    options={{
      autoplay: {
        delay: 7000,
        disableOnInteraction: false,
        waitForTransition: false,
      },
      loop: true,
      pagination: {
        el: ".swiper-pagination",
      },
      navigation: {
        nextEl: ".gallery-nav.next",
        prevEl: ".gallery-nav.prev",
      },
      mousewheel: true,
      keyboard: true,
    }}
  >
    <button type="button" class="gallery-nav prev" aria-label="Previous image">&#8249;</button>
    <SwiperWrapper>
      {images?.length > 0 &&
        images.map((image: any, i: number) => (
        <SwiperSlide>
            <img
								src={image?.src}
								alt={image?.alt ?? ""}
								class="h-full w-full rounded-xl border border-border/25 object-cover"
            />
        </SwiperSlide>
        ))}
    </SwiperWrapper>
    <button type="button" class="gallery-nav next" aria-label="Next image">&#8250;</button>
    <SwiperPagination />
  </Swiper>
</section>
<style define:vars={{ height, width }}>
 astro-swiper {
	 width: var(--width);
	 max-width: 100%;
	 aspect-ratio: 4 / 3;
	 max-height: var(--height);
 }

 section {
     --swiper-navigation-size: 25px;
     --swiper-navigation-top-offset: 50%;
     --swiper-navigation-sides-offset: 10px;
     --swiper-navigation-color: var(--carbon);
 }

 .gallery-nav {
	 position: absolute;
	 top: 0;
	 bottom: 0;
	 width: 50%;
	 border: 0;
	 padding: 0;
	 margin: 0;
	 background: transparent;
	 color: white;
	 font-size: 2rem;
	 line-height: 1;
	 text-shadow: 0 1px 4px rgba(0, 0, 0, 0.6);
	 opacity: 0;
	 transition: opacity 0.2s;
	 z-index: 10;
 }
 .gallery-nav.prev {
	 left: 0;
	 cursor: w-resize;
	 text-align: left;
	 padding-left: 0.75rem;
 }
 .gallery-nav.next {
	 right: 0;
	 cursor: e-resize;
	 text-align: right;
	 padding-right: 0.75rem;
 }
 section:hover .gallery-nav,
 .gallery-nav:focus-visible {
	 opacity: 1;
 }
</style>
