---
import { Image } from 'astro:assets';
import Section from '../ui/Section.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import Aurora from '../space/Aurora.astro';
import type { HeroBlock } from '../../lib/data';

interface Props { data: HeroBlock }

const { data } = Astro.props;

const actions = (data.actions ?? []).filter(a => a !== null);
---
<Section class="relative overflow-hidden">
	<Aurora />
	<div class="relative text-center sm:mx-auto lg:mr-auto">
		{data.headline && <h1  class="mt-8 text-balance text-6xl md:text-7xl xl:text-[5.25rem] font-semibold tracking-tight">{data.headline}</h1>}
			{data.tagline && <p  class="mx-auto my-8 max-w-2xl text-balance text-lg text-muted-foreground">{data.tagline}</p>}
			<div  class="max-w-full sm:max-w-2/3 mx-auto">
					{data.image?.src
					? <Image src={data.image.src} alt={data.image.alt ?? ''} width={911} height={606}  quality={100} fetchpriority="high" loading="eager" decoding="async" class="size-full object-cover" />
					: ''}
			</div>
			{actions.length > 0 && (
			<div class="mt-12 flex flex-col items-center justify-center gap-2 md:flex-row">
				{actions.map((action: any) => (
					<div  class="">
						<Button href={action.link} size="lg" variant={action.type === 'link' ? 'outline' : 'default'} class="rounded-xl px-5 text-base">
							{action.icon && <Icon name={action.icon} class="size-4" />}
							<span class="text-nowrap">{action.label}</span>
						</Button>
					</div>
				))}
			</div>
		)}
	</div>
</Section>
