---
import type { CmsBlog } from "../../lib/data";
import FormattedDate from "../FormattedDate.astro";
import RichText from "../../components/blocks/RichText.astro";

import NewGallery from "../blocks/NewGallery.astro";

interface Props {
  data?: CmsBlog | null;
}

const { data } = Astro.props;
---

{data?.heroImage &&
  !(data["imageGallery"] && data["imageGallery"]["images"].length) && (
    <div class="mx-auto max-w-4xl px-6">
      <img
        width={1020}
        height={510}
        src={data.heroImage}
        alt=""
        class="w-full rounded-2xl border shadow-lg"
      />
    </div>
  )}
{data["imageGallery"] && data["imageGallery"]["images"].length && (
  <section class="slider-container w-full mx-auto max-w-4xl px-6 w-[1000px] h-[500px]">
    <NewGallery data={data["imageGallery"]} />
  </section>
)}
{data && (
  <div class="w-full flex flex-col items-center">
    <div class="mx-auto max-w-3xl px-6 py-12">
      <div class="mb-8 text-center">
        {data.pubDate && (
          <div class="text-sm text-muted-foreground">
            <FormattedDate date={new Date(data.pubDate)} />
            {data.updatedDate && (
              <span class="italic">
                {" "}
                · Last updated{" "}
                <FormattedDate date={new Date(data.updatedDate)} />
              </span>
            )}
          </div>
        )}
        {data.title && (
          <h1 class="mt-2 text-4xl font-semibold tracking-tight lg:text-5xl">
            {data.title}
          </h1>
        )}
      </div>
    </div>
    <div class="mx-auto max-w-3xl px-6 py-12">
      {data.body && <RichText body={data.content} />}
    </div>
  </div>
)}
