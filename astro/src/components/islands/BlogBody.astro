---
import type { CmsBlog } from "../../lib/data";
import FormattedDate from "../FormattedDate.astro";
import RichText from "../../components/blocks/RichText.astro";

import Gallery from "../blocks/Gallery.astro";
import { getLangCode } from "@/utils/file_utils";

interface Props {
  data?: CmsBlog | null;
}

const { data } = Astro.props;

const lastUpdated =
  getLangCode() == "english" ? "Last Updated" : "Última actualización";
---

{data?.heroImage && !data?.hasImageGallery && (
  <div class="w-full flex flex-row justify-center py-4">
    <img
      width={1020}
      height={510}
      src={data.heroImage}
      alt=""
      class="rounded-2xl border shadow-lg max-w-4xl"
    />
  </div>
)}
{data?.hasImageGallery && data["imageGallery"]["images"].length && (
  <div class="mx-auto max-w-4xl px-6">
    <Gallery data={data["imageGallery"]} height={"500px"} width={"800px"} />
  </div>
)}
{data && (
  <div class="w-full flex flex-col items-center">
    <div class="mx-auto max-w-3xl px-6">
      <div class="mb-8 text-center">
        {data.pubDate && (
          <div class="text-sm text-muted-foreground">
            <FormattedDate date={new Date(data.pubDate)} />
            {data.updatedDate && (
              <span class="italic">
                {" "}
                · {lastUpdated}{" "}
                <FormattedDate date={new Date(data.updatedDate)} />
              </span>
            )}
          </div>
        )}
        {data.title && (
          <h1 class="mt-2 text-4xl font-semibold tracking-tight lg:text-5xl">
            {data.title}
          </h1>
        )}
      </div>
    </div>
    <div class="mx-auto max-w-3xl px-6 py-12">
      {data.body && <RichText body={data.body} />}
    </div>
  </div>
)}
