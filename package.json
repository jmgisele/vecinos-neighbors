{
  "name": "vecinos-neighbors",
  "description": "Astro frontent, Mattrbld backend",
  "private": true,
  "workspaces": [
    "astro",
    "mattrbld-local"
  ],
	"type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel --print-label dev:*",
    "dev:astro": "npm run dev --workspace=astro",
    "dev:mattrbld": "npm run dev --workspace=mattrbld-local",
		"dev:proxy": "npm run proxy --workspace=mattrbld-local",
    "format": "prettier --cache --write ./astro",
		"prebuild": "node before-build.js"
  },
  "devDependencies": {
    "npm-run-all2": "^5.0.2"
  },
  "dependencies": {
    "baseline-browser-mapping": "^2.9.11"
  }
}
